# Copy this file to .env.local for local development, and add the same two
# values in Vercel: Project → Settings → Environment Variables.
#
# Find these in Supabase: Project → Settings → API
#   - NEXT_PUBLIC_SUPABASE_URL is the "Project URL" (no trailing /rest/v1/)
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY is the "anon public" / "Publishable" key
#     — safe to expose in client-side code, this is not a secret key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
